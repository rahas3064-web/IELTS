# Copy to .env locally. Do not commit .env.
# The browser build must not read this file.
# On Liara, set these in the app environment. Never put real values in git.
# Production validates this at boot (server/core/env.js) and refuses to start
# when a required variable is missing; variables marked "required in prod" below.

# Core
NODE_ENV=development
PORT=3000
APP_BASE_URL=                 # required in prod, e.g. https://bandora.ir
# Postgres URL (required in prod). Empty in dev -> PGlite in data/pglite.
# Local dev can also use: pglite:./data/pglite  (PGLITE_DIR relocates the default folder)
DATABASE_URL=
SESSION_SECRET=               # required in prod, at least 32 random bytes
OTP_PEPPER=                   # required in prod, HMAC key for OTP hashes, at least 32 chars
TZ=Asia/Tehran

# AI (AvalAI, OpenAI-compatible)
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=                 # chat/scoring model, e.g. gpt-4o-mini
AVALAI_SCORING_MODEL=         # optional stronger model for Writing/Speaking scoring
AVALAI_STT_MODEL=whisper-1
AI_COST_PER_1K_INPUT_RIAL=    # for admin cost estimates
AI_COST_PER_1K_OUTPUT_RIAL=

# SMS.ir
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_TEMPLATE_OTP=           # template id, parameter CODE
SMSIR_TEMPLATE_STUDY_REMINDER=
SMSIR_TEMPLATE_RENEWAL_REMINDER=
SMS_DEV_CONSOLE=true          # dev: print instead of send (must be opted into in prod)
# Local demo only: true skips the SMS code step on the real login forms.
# Keep false here, on Liara and everywhere else; production refuses to start with true.
AUTH_DEV_BYPASS=false

# Bale payment
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
BALE_PAYMENT_PROVIDER_TOKEN=  # official test value (no real money moves): WALLET-TEST-1111111111111111
BALE_PAYMENT_MODE=test        # test | live. A real wallet token is ignored unless this is live.
BALE_PAYMENT_FLOW=bot_chat    # bot_chat | invoice_link
BALE_WEBHOOK_SECRET=
# Later: ZARINPAL_MERCHANT_ID=, ZIBAL_MERCHANT=

# Storage (audio/images), S3-compatible (Liara Object Storage)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Admin bootstrap (runtime only, optional alternative to --phone)
ADMIN_BOOTSTRAP_PHONE=

# Scheduled jobs (study reminders, OTP cleanup). Always on when NODE_ENV=production;
# set to 1 to run them in development too (outside production SMS are only printed, never sent).
ENABLE_JOBS=

# Scratch PGlite folder for CLIs/tests (only used when DATABASE_URL is empty)
# PGLITE_DIR=
